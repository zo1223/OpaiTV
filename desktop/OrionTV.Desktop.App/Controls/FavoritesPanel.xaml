<UserControl x:Class="OrionTV.Desktop.App.Controls.FavoritesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OrionTV.Desktop.App"
             Visibility="Collapsed"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="OnPreviewKeyDown">
    <!-- 收藏侧滑面板：半透明遮罩 + 从内容区右侧滑入的列表。数据与收藏页同源（FavoriteStore.GetVisibleEntries）。 -->
    <Grid>
        <Border x:Name="Scrim"
                Background="#99000000"
                Opacity="0"
                MouseLeftButtonUp="Scrim_MouseLeftButtonUp" />

        <Border x:Name="Drawer"
                Width="380"
                HorizontalAlignment="Right"
                Margin="0,8,0,12"
                CornerRadius="24,0,0,24"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1,1,0,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="380" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="18,14,8,8">
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE711;"
                            ToolTip="关闭"
                            Click="CloseButton_Click" />
                    <TextBlock x:Name="TitleText"
                               Text="我的收藏"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Items" Margin="10,0,6,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row"
                                        Background="Transparent"
                                        CornerRadius="14"
                                        Padding="8"
                                        Margin="0,2"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="54"
                                                Height="76"
                                                CornerRadius="10"
                                                Background="{StaticResource PanelAltBrush}"
                                                ClipToBounds="True">
                                            <Image Stretch="UniformToFill" app:ImageLoader.SourceUrl="{Binding Item.Cover}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0">
                                            <TextBlock Text="{Binding Item.Title}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Item.SourceName}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Item.Year}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButtonStyle}"
                                                Width="36"
                                                Height="36"
                                                FontSize="14"
                                                Content="&#xE74D;"
                                                ToolTip="取消收藏"
                                                VerticalAlignment="Center"
                                                Click="RemoveButton_Click" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="1"
                           Text="暂无收藏"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           Visibility="Collapsed" />

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrushDark}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Button x:Name="ViewAllButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="查看全部收藏"
                            HorizontalAlignment="Stretch"
                            Click="ViewAllButton_Click" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
