<UserControl x:Class="OrionTV.Desktop.App.Controls.HeroBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="False"
             Margin="6,0,6,12">
    <!-- 首页大横幅：海报背景 + 标题 / 简介 + 播放 / 详情按钮 + 指示点。条目与轮播逻辑见 HeroBannerControl.xaml.cs -->
    <Border x:Name="Root"
            Height="280"
            CornerRadius="28"
            Background="{StaticResource PanelAltBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            SizeChanged="Root_SizeChanged"
            MouseEnter="Root_MouseEnter"
            MouseLeave="Root_MouseLeave">
        <Grid>
            <Grid x:Name="SlideLayer">
                <!-- 背景与左侧小海报共用同一张已加载的图，不重复取图 -->
                <Image Source="{Binding Source, ElementName=PosterImage}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.45"
                       IsHitTestVisible="False" />
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F20A0B14" Offset="0" />
                            <GradientStop Color="#B30A0B14" Offset="0.55" />
                            <GradientStop Color="#400A0B14" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="30,30,30,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="144" Height="216" CornerRadius="16" Background="#FF1B1F33" ClipToBounds="True">
                        <Image x:Name="PosterImage" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,144,216" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                        </Image>
                    </Border>

                    <Grid Grid.Column="1" Margin="22,0,96,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TitleText"
                                   Grid.Row="0"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetaText"
                                   Grid.Row="1"
                                   Foreground="{StaticResource GoldBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DescText"
                                   Grid.Row="2"
                                   Foreground="{StaticResource SoftTextBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   MaxHeight="66"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="42"
                                    MinWidth="132"
                                    Padding="20,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Content="▶  播放"
                                    ToolTip="直接播放（有观看记录时接着上次的进度）"
                                    Click="PlayButton_Click" />
                            <Button x:Name="DetailButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="42"
                                    MinWidth="96"
                                    Padding="18,0"
                                    FontSize="15"
                                    Margin="12,0,0,0"
                                    Content="详情"
                                    Click="DetailButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Button x:Name="PrevButton"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE76B;"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,60,0"
                    ToolTip="上一张"
                    Visibility="Collapsed"
                    Click="PrevButton_Click" />
            <Button x:Name="NextButton"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE76C;"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,16,0"
                    ToolTip="下一张"
                    Visibility="Collapsed"
                    Click="NextButton_Click" />
            <StackPanel x:Name="Dots"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,26,22" />
        </Grid>
    </Border>
</UserControl>
