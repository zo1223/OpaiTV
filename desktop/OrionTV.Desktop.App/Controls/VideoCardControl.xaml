<UserControl x:Class="OrionTV.Desktop.App.Controls.VideoCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             Width="150"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             MouseLeftButtonUp="OnClick">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <StackPanel Margin="6,6,6,12">
        <Border x:Name="CardBorder"
                Width="150"
                Height="210"
                CornerRadius="8"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="Transparent"
                BorderThickness="2"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Border.RenderTransform>
            <Grid>
                <Image x:Name="PosterImage" Stretch="UniformToFill" />

                <Border x:Name="SourceBadge"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="8"
                        Background="#B3000000"
                        CornerRadius="6"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SourceText" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>

                <Border x:Name="MetaBadge"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="8"
                        Background="#B3000000"
                        CornerRadius="6"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MetaText" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>

                <Border x:Name="ProgressTrack"
                        VerticalAlignment="Bottom"
                        Height="4"
                        Background="#CC000000"
                        Visibility="Collapsed">
                    <Border x:Name="ProgressBar"
                            HorizontalAlignment="Left"
                            Height="4"
                            Width="0"
                            Background="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText"
                   Margin="2,8,2,0"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="13"
                   LineHeight="18"
                   MaxHeight="40"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="ContinueText"
                   Margin="2,2,2,0"
                   Foreground="{StaticResource PrimaryBrush}"
                   FontSize="12"
                   Visibility="Collapsed"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
