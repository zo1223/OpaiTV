<UserControl x:Class="OrionTV.Desktop.App.Controls.VideoCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OrionTV.Desktop.App"
             Cursor="Hand"
             Width="150"
             MouseEnter="OnMouseEnter"
             MouseMove="OnMouseMove"
             MouseLeave="OnMouseLeave"
             MouseLeftButtonUp="OnClick">
    <StackPanel x:Name="Root" Margin="6,6,6,12">
        <!-- 入场动画（淡入 + 上移到位）只动这个位移，与悬浮姿态互不干扰 -->
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="EntranceShift" />
        </StackPanel.RenderTransform>
        <!-- 宽度与布局槽一致：控件宽 150 减去左右各 6 的外边距。写成 150 时右侧 12px 会被布局裁掉 -->
        <Border x:Name="CardBorder"
                Width="138"
                Height="210"
                CornerRadius="8"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="Transparent"
                BorderThickness="2"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <!-- 悬浮姿态：放大 + 跟随鼠标的轻微斜切 + 抬起/位移，全部是渲染变换，不触发布局 -->
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" />
                    <SkewTransform x:Name="CardSkew" />
                    <TranslateTransform x:Name="CardShift" />
                    <TranslateTransform x:Name="CardLift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid Background="#FF25292B">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                        <TextBlock Text="&#xE8B2;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource SoftTextBrush}"
                                   FontSize="34"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="暂无海报"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="0,9,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Image x:Name="PosterImage" Stretch="UniformToFill" app:ImageLoader.FadeIn="True" />

                <!-- 悬浮高光：中心跟随鼠标，平时完全透明，不参与命中测试 -->
                <Border x:Name="GlareLayer" IsHitTestVisible="False" Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush x:Name="GlareBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.6">
                            <GradientStop Color="#30FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="SourceBadge"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="8"
                        Background="#B3000000"
                        CornerRadius="6"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SourceText" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>

                <Border x:Name="MetaBadge"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="8"
                        Background="#B3000000"
                        CornerRadius="6"
                        Padding="6,3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MetaText" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>

                <Border x:Name="ProgressTrack"
                        VerticalAlignment="Bottom"
                        Height="4"
                        Background="#CC000000"
                        Visibility="Collapsed">
                    <Border x:Name="ProgressBar"
                            HorizontalAlignment="Left"
                            Height="4"
                            Width="0"
                            Background="{StaticResource PrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText"
                   Margin="2,8,2,0"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="13"
                   LineHeight="18"
                   MaxHeight="40"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="ContinueText"
                   Margin="2,2,2,0"
                   Foreground="{StaticResource PrimaryBrush}"
                   FontSize="12"
                   Visibility="Collapsed"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
