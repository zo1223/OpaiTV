<Window x:Class="OrionTV.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:OrionTV.Desktop.App.Controls"
        mc:Ignorable="d"
        Title="OpaiTV" Height="820" Width="1280" MinHeight="680" MinWidth="1040"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题栏（CineFlow 式）：侧栏开关 + 品牌 + 搜索输入框 + 操作按钮。全屏时隐藏。
             这里的按钮都是已有入口的快捷方式（与侧栏项走同一个处理函数），不新增功能。 -->
        <Border x:Name="TopBar" Grid.Row="0" Grid.ColumnSpan="2" Height="68">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1F6FDCA8" Offset="0" />
                    <GradientStop Color="#000A0B14" Offset="0.38" />
                    <GradientStop Color="#000A0B14" Offset="0.7" />
                    <GradientStop Color="#14E3B26B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggle"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE700;"
                            Margin="0,0,8,0"
                            ToolTip="收起 / 展开侧栏（展开 → 仅图标 → 隐藏）"
                            Click="SidebarToggle_Click" />
                    <Border Width="34" Height="34" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6FDCA8" Offset="0" />
                                <GradientStop Color="#E3B26B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{StaticResource OnPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="OpaiTV"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                        <TextBlock Text="影视 · 直播 · 本地"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 顶栏搜索：真输入框（CineFlow 式）。回车或点放大镜即搜索：跳到搜索页并带上关键词；
                     与搜索页输入框共用同一查询状态（Services.SearchQuery），两处始终显示同一关键词。 -->
                <Border x:Name="TopSearchPill"
                        Grid.Column="1"
                        Style="{StaticResource TopSearchPillStyle}"
                        MaxWidth="620"
                        Margin="36,0,36,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TopSearchButton"
                                Grid.Column="0"
                                Style="{StaticResource TopSearchIconButtonStyle}"
                                ToolTip="搜索"
                                Click="TopSearch_Click" />
                        <TextBox x:Name="TopSearchBox"
                                 Grid.Column="1"
                                 Style="{StaticResource TopSearchTextBoxStyle}"
                                 Tag="搜索电影、剧集…"
                                 ToolTip="输入关键词，按回车搜索"
                                 KeyDown="TopSearchBox_KeyDown"
                                 TextChanged="TopSearchBox_TextChanged" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TopFavoritesButton" Style="{StaticResource IconButtonStyle}" Content="&#xEB51;" ToolTip="收藏" Click="TopFavorites_Click" />
                    <Grid>
                        <Button x:Name="TopSettingsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" ToolTip="设置" Click="TopSettings_Click" />
                        <Ellipse x:Name="TopSettingsUpdateDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#FFFF3B30"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,9,9,0"
                                 IsHitTestVisible="False"
                                 ToolTip="有新版本可更新"
                                 Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侧栏：悬浮圆角面板，可在 展开 / 仅图标 / 隐藏 三态间切换（顶部栏左侧开关） -->
        <Border x:Name="Sidebar"
                Grid.Row="1"
                Grid.Column="0"
                Margin="12,4,0,12"
                CornerRadius="24"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1">
            <!-- 被左边缘把手拉出时从屏外滑入，只动这个位移，不触发布局 -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarShift" />
            </Border.RenderTransform>
            <DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12">
                        <TextBlock x:Name="NavHeaderMain" Text="主要功能" Style="{StaticResource SectionHeaderStyle}" />
                        <RadioButton x:Name="NavPlayer" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE768;" Content="正在播放" ToolTip="正在播放" Visibility="Collapsed" Click="Nav_Click" />
                        <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE80F;" Content="首页" ToolTip="首页" Click="Nav_Click" />
                        <RadioButton x:Name="NavSearch" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE721;" Content="搜索" ToolTip="搜索" Click="Nav_Click" />
                        <RadioButton x:Name="NavLive" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE714;" Content="直播" ToolTip="直播" Click="Nav_Click" />
                        <RadioButton x:Name="NavLocalVideo" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE8B7;" Content="本地视频" ToolTip="本地视频" Click="Nav_Click" />

                        <TextBlock x:Name="NavHeaderAi" Text="AI 工具" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <RadioButton x:Name="NavClaude" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE99A;" Content="Claude Code" ToolTip="Claude Code" Click="Nav_Click" />
                        <RadioButton x:Name="NavCodex" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE943;" Content="Codex" ToolTip="Codex" Click="Nav_Click" />

                        <TextBlock x:Name="NavHeaderUser" Text="用户" Style="{StaticResource SectionHeaderStyle}" Margin="14,16,0,6" />
                        <RadioButton x:Name="NavFavorites" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xEB51;" Content="收藏" ToolTip="收藏" Click="Nav_Click" />
                        <Grid>
                            <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource SidebarItemStyle}" Tag="&#xE713;" Content="设置" ToolTip="设置" Click="Nav_Click" />
                            <!-- 更新小红点：有新版本可更新时显示，点“设置”进入现有更新流程 -->
                            <Ellipse x:Name="SettingsUpdateDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#FFFF3B30"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,22,0"
                                     IsHitTestVisible="False"
                                     ToolTip="有新版本可更新"
                                     Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <ContentControl x:Name="ContentHost">
                <!-- 页面切换动效（淡入 + 轻微上移）只动这个位移与透明度，不触发布局 -->
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ContentShift" />
                </ContentControl.RenderTransform>
            </ContentControl>
            <!-- 侧栏隐藏档的拉出把手：贴左边缘、竖直居中，只在隐藏档出现（见 MainWindow.ApplySidebarMode）；
                 点一下侧栏滑出并回到展开档（带文字的完整栏目）。盖在页面内容之上，在播放页与收藏面板之下。 -->
            <Button x:Name="SidebarPullHandle"
                    Panel.ZIndex="5"
                    Style="{StaticResource SidebarPullHandleStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTip="展开侧栏"
                    Visibility="Collapsed"
                    Click="SidebarPullHandle_Click" />
            <!-- 播放页独立常驻；切到侧栏其他栏目时只隐藏，不卸载播放器原生宿主。 -->
            <ContentControl x:Name="PlayerHost" Visibility="Collapsed" Panel.ZIndex="10" />
            <!-- 收藏侧滑面板：盖在内容区之上，从右侧滑入。 -->
            <ctrl:FavoritesPanel x:Name="FavoritesPanel" Panel.ZIndex="20" />
        </Grid>
    </Grid>
</Window>
