<Window x:Class="OrionTV.Desktop.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="OpaiTV 小窗播放"
        Width="400" Height="289"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{StaticResource PanelBrush}"
        FontFamily="Microsoft YaHei UI">
    <!-- 迷你播放窗口（灵动岛）：上面是画面（点一下回到全屏播放页），下面是片名 / 进度 / 播放暂停 / 收起 / 关闭。
         控件都放在画面之外的信息栏里，不盖在原生视频画面上（避开 LibVLCSharp 的 airspace）。 -->
    <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1">
        <DockPanel x:Name="RootPanel">
            <Border x:Name="InfoBar" DockPanel.Dock="Bottom" Height="62" Padding="10,6,4,6"
                    Background="{StaticResource PanelBrush}"
                    MouseLeftButtonDown="InfoBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="ProgressIndicator" Height="4" Margin="0,6,0,4" Minimum="0" Maximum="1"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     Background="{StaticResource InputBrush}" BorderThickness="0"
                                     Cursor="Hand" ToolTip="点击跳转"
                                     MouseLeftButtonDown="ProgressIndicator_MouseLeftButtonDown" />
                        <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Text="00:00 / --:--" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                FontSize="14" Content="&#xE768;" Click="PlayPauseButton_Click" ToolTip="播放/暂停" />
                        <Button x:Name="RestoreButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                FontSize="14" Content="&#xE740;" Click="RestoreButton_Click" ToolTip="回到播放器" />
                        <Button x:Name="CollapseButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                FontSize="14" Content="&#xE70D;" Click="CollapseButton_Click" ToolTip="收起" />
                        <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                FontSize="14" Content="&#xE711;" Click="CloseButton_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="VideoArea" Background="{StaticResource VideoBrush}">
                <vlc:VideoView x:Name="VideoSurface">
                    <!-- 近透明背景才能接收鼠标：点画面回到全屏播放页 -->
                    <Grid Background="#01000000" Cursor="Hand" ToolTip="点击回到播放器"
                          MouseLeftButtonUp="Video_MouseLeftButtonUp">
                        <TextBlock x:Name="StatusText" Foreground="#E6FFFFFF" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="正在接着播放…" IsHitTestVisible="False" />
                    </Grid>
                </vlc:VideoView>
            </Grid>
        </DockPanel>
    </Border>
</Window>
