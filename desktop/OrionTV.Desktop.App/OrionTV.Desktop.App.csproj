<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrionTV.Desktop.Core\OrionTV.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.4" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- 便携 mpv（方式 A：不依赖 PATH），本地文件内嵌播放 -->
    <Content Include="..\tools\mpv-extract\**\*">
      <Link>mpv\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- AI CLI 必读：项目说明打进发布包 -->
    <Content Include="..\docs\ORION_SOURCE_GUIDE.md">
      <Link>docs\ORION_SOURCE_GUIDE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>OpaiTV</AssemblyName>
    <RootNamespace>OrionTV.Desktop.App</RootNamespace>
    <Product>OpaiTV</Product>
    <AssemblyTitle>OpaiTV</AssemblyTitle>
    <Version>1.3.23</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\OpaiTV.ico</ApplicationIcon>
    <!-- 应用仅发布 win-x64，排除 LibVLC 的 x86 运行库（约省 95MB） -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

</Project>
