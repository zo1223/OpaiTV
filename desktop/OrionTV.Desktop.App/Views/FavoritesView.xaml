<UserControl x:Class="OrionTV.Desktop.App.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:OrionTV.Desktop.App.Controls">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ctrl:PageHeader x:Name="Header" Grid.Row="0" Title="我的收藏" />
        <ctrl:CardGrid x:Name="Grid" Grid.Row="1" />
    </Grid>
</UserControl>
