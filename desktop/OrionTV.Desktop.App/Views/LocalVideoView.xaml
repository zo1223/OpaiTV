<UserControl x:Class="OrionTV.Desktop.App.Views.LocalVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:OrionTV.Desktop.App.Controls">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctrl:PageHeader x:Name="Header" Grid.Row="0" Title="本地视频" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="900">
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="播放本地视频" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="支持 MP4、MKV、AVI、MOV、WebM、TS 和本地 M3U8。详情页下载可后台继续；可同时多个任务，播放其他视频互不影响。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="选择视频文件" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="18,0" Click="OpenLocalFileButton_Click" />
                            <Button Content="打开缓存目录" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="10,0,0,0" Click="OpenCacheFolderButton_Click" />
                            <Button Content="刷新列表" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="10,0,0,0" Click="RefreshButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                    <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ActiveHeaderText" Text="后台下载" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ActiveEmptyText" Text="暂无进行中的下载；在详情页点下载后可选择后台继续" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,0,0,8" />
                <ItemsControl x:Name="ActiveDownloadList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanelStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                                        <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="15,0"
                                                Visibility="{Binding CancelVisibility}" Click="CancelActiveButton_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="{StaticResource SoftTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                    <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="本地下载" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="EmptyText" Text="暂无本地下载；请在视频详情页下载" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,24" HorizontalAlignment="Center" />
                <ItemsControl x:Name="CacheList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanelStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                                        <Button Content="播放" Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="15,0" Click="PlayCacheButton_Click" />
                                        <Button Content="优化拖动" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="15,0" Margin="8,0,0,0"
                                                Visibility="{Binding OptimizeVisibility}" Click="OptimizeSeekButton_Click"
                                                ToolTip="把 TS 转封装为可快速拖动的 MP4（不重编码，需本机安装 ffmpeg）" />
                                        <Button Content="一键解密合并" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="15,0" Margin="8,0,0,0"
                                                Visibility="{Binding DecryptVisibility}" Click="DecryptMergeButton_Click"
                                                ToolTip="将 AES-128 加密分片解密并合并为单个 merged.ts" />
                                        <Button Content="继续下载" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="15,0" Margin="8,0,0,0"
                                                Visibility="{Binding ResumeVisibility}" Click="ResumeCacheButton_Click" />
                                        <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="15,0" Margin="8,0,0,0" Click="DeleteCacheButton_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource SoftTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
