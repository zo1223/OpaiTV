<UserControl x:Class="OrionTV.Desktop.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:local="clr-namespace:OrionTV.Desktop.App.LocalPlayback"
             xmlns:controls="clr-namespace:OrionTV.Desktop.App.Controls"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="PlayerRoot" Background="{StaticResource VideoBrush}" ClipToBounds="True">
        <!-- Hidden 仍参与完整布局，mpv 可在首帧输出前完成 HWND 创建和尺寸同步。 -->
        <local:MpvHost x:Name="LocalVideoHost" Visibility="Hidden"
                       IsHitTestVisible="False" SnapsToDevicePixels="True" />

        <!-- 所有 overlay 必须作为 VideoView 的 Content（绕开 LibVLCSharp.WPF 的 airspace；
             根容器使用近透明背景 #01000000 才能接收鼠标事件）。 -->
        <vlc:VideoView x:Name="VideoSurface">
            <Grid x:Name="OverlayRoot" Background="#01000000"
                  MouseLeftButtonDown="Overlay_MouseDown"
                  MouseWheel="Overlay_MouseWheel">

                <!-- 弹幕层：盖在画面上、其他 overlay 之下；不接收鼠标。弹幕开关关闭或没有匹配到时是空的 -->
                <controls:DanmakuOverlay x:Name="DanmakuLayer" />

                <!-- 加载 / 缓冲 -->
                <Border x:Name="LoadingOverlay" Background="{StaticResource VideoBrush}" Visibility="Collapsed">
                    <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="300" Height="4" Margin="0,0,0,18"
                                     HorizontalAlignment="Center" IsIndeterminate="True"
                                     Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock x:Name="LoadingStageText" Text="正在准备播放器" MaxWidth="520"
                                   Foreground="White" FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="LoadingText" Text="程序仍在工作，请稍候…" MaxWidth="520"
                                   Foreground="#E6FFFFFF" FontSize="14" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 错误 -->
                <Border x:Name="ErrorOverlay" Background="#88000000" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText" Text="无法播放该地址" Foreground="White" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <Button Content="重试" Style="{StaticResource SecondaryButtonStyle}" Height="38" Width="100"
                                HorizontalAlignment="Center" Click="RetryButton_Click" />
                    </StackPanel>
                </Border>

                <!-- 跳过广告提示 -->
                <Border x:Name="AdSkipBadge"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="#CC6FDCA8" CornerRadius="15" Padding="14,7" Margin="0,64,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="已跳过广告" Foreground="#06140E" FontSize="14" FontWeight="SemiBold" />
                </Border>

                <!-- 投屏中：当前设备与状态（面板关着也看得到），点一下打开投屏面板 -->
                <Border x:Name="CastBadge"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="#CC1F6FEB" CornerRadius="15" Padding="14,7" Margin="0,104,0,0"
                        Cursor="Hand" ToolTip="打开投屏控制"
                        MouseLeftButtonDown="CastBadge_MouseLeftButtonDown"
                        Visibility="Collapsed">
                    <TextBlock x:Name="CastBadgeText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               MaxWidth="560" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- 弹幕状态轻提示：已开启/已关闭、未找到该集弹幕、获取失败；几秒后自动消失，不接收鼠标 -->
                <Border x:Name="DanmakuNoticeBadge"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="#CC0A0B14" CornerRadius="15" Padding="14,7" Margin="0,0,0,92"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="DanmakuNoticeText" Foreground="White" FontSize="14"
                               MaxWidth="560" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- 顶部标题栏 -->
                <Border x:Name="TopBar" VerticalAlignment="Top" Padding="8,6,8,16"
                        MouseEnter="Bar_MouseEnter" MouseLeave="Bar_MouseLeave">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#CC000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;" Click="BackButton_Click" ToolTip="返回 (Esc)" />
                        <Button x:Name="EpisodesButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Height="38" MinWidth="58" Padding="14,0" Content="选集" Click="EpisodesButton_Click" />
                        <Button x:Name="SourceSwitchButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"
                                Height="38" MinWidth="58" Padding="14,0" Margin="0,0,8,0" Content="换源"
                                Visibility="Collapsed" Click="SourceSwitchButton_Click" />
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- 底部控制栏 -->
                <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="14,16,14,10"
                        MouseEnter="Bar_MouseEnter" MouseLeave="Bar_MouseLeave">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#D9000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Style="{StaticResource IconButtonStyle}" Content="&#xE892;" Click="PrevButton_Click" ToolTip="上一集" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButtonStyle}" Content="&#xE768;" Click="PlayPauseButton_Click" ToolTip="播放/暂停 (空格)" />
                            <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Content="&#xE893;" Click="NextButton_Click" ToolTip="下一集" />
                            <Button x:Name="StopButton" Style="{StaticResource IconButtonStyle}" Content="&#xE71A;" Click="StopButton_Click" ToolTip="停止" />
                        </StackPanel>

                        <TextBlock x:Name="PositionText" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13" Text="00:00" />

                        <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1000" IsMoveToPointEnabled="True"
                                ValueChanged="SeekSlider_ValueChanged"
                                Thumb.DragStarted="SeekSlider_DragStarted" Thumb.DragCompleted="SeekSlider_DragCompleted" />

                        <TextBlock x:Name="DurationText" Grid.Column="3" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontSize="13" Text="00:00" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                            <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}" FontSize="16" Content="&#xE767;" Click="MuteButton_Click" ToolTip="静音 (M)" />
                            <Slider x:Name="VolumeSlider" Width="80" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                            <Button x:Name="MiniPlayerButton" Style="{StaticResource IconButtonStyle}" FontSize="16" Content="&#xE8A7;" Click="MiniPlayerButton_Click" ToolTip="小窗播放（离开播放页，在置顶小窗口里接着播）" />
                            <ToggleButton x:Name="DanmakuButton" Width="38" Height="38" Margin="2,0" Cursor="Hand"
                                          Focusable="False"
                                          Click="DanmakuButton_Click" ToolTip="弹幕 开/关">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                                BorderThickness="1.5" BorderBrush="#66FFFFFF" Margin="5">
                                            <TextBlock x:Name="Label" Text="弹" Foreground="#99FFFFFF"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button x:Name="CastButton" Style="{StaticResource IconButtonStyle}" FontSize="16" Content="&#xE7F4;" Click="CastButton_Click" ToolTip="投屏到电视（DLNA）" />
                        </StackPanel>

                        <Button x:Name="FullscreenButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE740;" Click="FullscreenButton_Click" ToolTip="全屏 (F / 双击)" />
                    </Grid>
                </Border>

                <!-- 选集侧栏 -->
                <Border x:Name="SidePanel" HorizontalAlignment="Right" Width="320" Background="#F20A0B14"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" CornerRadius="24,0,0,24" Visibility="Collapsed"
                        MouseEnter="Bar_MouseEnter" MouseLeave="Bar_MouseLeave">
                    <DockPanel Margin="14">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" Click="EpisodesButton_Click" />
                            <TextBlock Text="选集" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" Text="剧集" Foreground="{StaticResource SoftTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="EpisodeBar" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 历史播放的当前集实时换源侧栏 -->
                <Border x:Name="SourceSwitchPanel" HorizontalAlignment="Right" Width="420" Background="#F20A0B14"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" CornerRadius="24,0,0,24" Visibility="Collapsed"
                        MouseEnter="Bar_MouseEnter" MouseLeave="Bar_MouseLeave">
                    <DockPanel Margin="14">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                                    Click="SourceSwitchButton_Click" ToolTip="关闭" />
                            <TextBlock Text="更换播放源" Foreground="{StaticResource TextBrush}" FontSize="16"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="SourceSwitchEpisodeText" Foreground="{StaticResource SoftTextBrush}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DockPanel LastChildFill="True">
                                <Button x:Name="SourceScanButton" DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0"
                                        Content="重新测速" Click="SourceScanButton_Click" />
                                <TextBlock x:Name="SourceScanSummaryText" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                            </DockPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SourceSwitchList" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 投屏（DLNA）侧栏：未投屏时是设备列表，投屏中是设备、状态与控制 -->
                <Border x:Name="CastPanel" HorizontalAlignment="Right" Width="360" Background="#F20A0B14"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" CornerRadius="24,0,0,24" Visibility="Collapsed"
                        MouseEnter="Bar_MouseEnter" MouseLeave="Bar_MouseLeave">
                    <DockPanel Margin="14">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                                    Click="CastButton_Click" ToolTip="关闭" />
                            <TextBlock Text="投屏" Foreground="{StaticResource TextBrush}" FontSize="16"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel x:Name="CastSessionSection" DockPanel.Dock="Top" Visibility="Collapsed">
                            <TextBlock x:Name="CastDeviceNameText" Foreground="{StaticResource TextBrush}" FontSize="15"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CastStateText" Foreground="{StaticResource SoftTextBrush}" FontSize="13"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="CastErrorText" Foreground="#FFFF8A80" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <Slider x:Name="CastSeekSlider" Minimum="0" Maximum="1000" IsMoveToPointEnabled="True"
                                    Margin="0,14,0,4"
                                    ValueChanged="CastSeekSlider_ValueChanged"
                                    Thumb.DragStarted="CastSeekSlider_DragStarted"
                                    Thumb.DragCompleted="CastSeekSlider_DragCompleted" />
                            <TextBlock x:Name="CastTimeText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0"
                                        Content="-30 秒" Click="CastBackButton_Click" />
                                <Button x:Name="CastPlayPauseButton" Style="{StaticResource PrimaryButtonStyle}" Height="36"
                                        MinWidth="92" Padding="12,0" Margin="8,0" Content="暂停"
                                        Click="CastPlayPauseButton_Click" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0"
                                        Content="+30 秒" Click="CastForwardButton_Click" />
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,14,0,0"
                                    Content="停止投屏，回到本机播放" Click="CastStopButton_Click" />
                        </StackPanel>

                        <DockPanel x:Name="CastDevicesSection">
                            <TextBlock x:Name="CastNoticeText" DockPanel.Dock="Top" Foreground="{StaticResource SoftTextBrush}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
                            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
                                <Button x:Name="CastRescanButton" DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="12,0"
                                        Content="重新搜索" Click="CastRescanButton_Click" />
                                <TextBlock x:Name="CastSearchText" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                            </DockPanel>
                            <ProgressBar x:Name="CastSearchProgress" DockPanel.Dock="Top" Height="3" Margin="0,0,0,10"
                                         IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}"
                                         Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CastDeviceList" />
                            </ScrollViewer>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>
