<UserControl x:Class="OrionTV.Desktop.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:OrionTV.Desktop.App.Controls">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctrl:PageHeader x:Name="Header" Grid.Row="0" Title="设置" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="检查更新"
                                    Width="128" Height="38" Margin="14,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="CheckUpdateButton_Click" />
                            <StackPanel>
                                <TextBlock Text="软件更新" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrentVersionText" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="UpdateProgressBar" Height="5" Minimum="0" Maximum="100"
                                     Margin="0,14,0,0" Foreground="{StaticResource PrimaryBrush}"
                                     Background="{StaticResource InputBrush}" BorderThickness="0"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateNotesText" Foreground="{StaticResource SoftTextBrush}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="API 地址" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="ApiBox" Tag="输入服务器地址（可选）" TextChanged="OnFieldChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="SubHint" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontStyle="Italic" VerticalAlignment="Center" />
                            <TextBlock Text="影视源订阅链接" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBox x:Name="SubBox" Tag="输入影视源订阅地址" TextChanged="OnFieldChanged" />
                        <TextBlock Text="桌面端使用 AppleCMS / 订阅 JSON / AI 额外源（extra_sources）。不再内置 TVBox 代理。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 成人内容(18+)：默认关闭；切换后立即生效并保存，不随“保存设置”提交。
                     放在“一键加源”之前：下面的源列表再长，开关的位置也不变 -->
                <!-- 个性化推荐：默认开；纯本地计算，改了立即生效并保存 -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <DockPanel>
                        <ToggleButton x:Name="RecommendToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      Checked="RecommendToggle_Changed" Unchecked="RecommendToggle_Changed" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="个性化推荐" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecommendStatus" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Text="首页显示“为你推荐”。仅在本机根据观看历史与收藏计算，不联网、不上传观看记录" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- TMDB 元数据：填了自己的 Key 才启用；改了立即保存，不随“保存设置”提交 -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="TMDB 元数据" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,8" TextWrapping="Wrap"
                                   Text="填写自己的 TMDB API Key（或 Read Access Token）后，详情页会用 TMDB 补全缺少的海报、简介、年份，并显示 TMDB 评分。Key 只保存在本机，只会发给 TMDB 官方接口；填写后打开详情页时会把片名发给 TMDB 查询；留空则不启用。" />
                        <DockPanel>
                            <Button x:Name="TmdbKeyClearButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="14,0" Margin="8,0,0,0" FontSize="13" Content="清除" Click="TmdbKeyClearButton_Click" />
                            <PasswordBox x:Name="TmdbKeyBox" Height="36" FontSize="14" VerticalContentAlignment="Center"
                                         PasswordChanged="TmdbKeyBox_PasswordChanged" />
                        </DockPanel>
                        <TextBlock x:Name="TmdbKeyStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <DockPanel>
                        <ToggleButton x:Name="AdultContentToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      Checked="AdultContentToggle_Changed" Unchecked="AdultContentToggle_Changed" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="成人内容(18+)" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="AdultContentStatus" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 一键加源：校验通过即写入 extra_sources.json 并生效，不随“保存设置”提交 -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="一键加源" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddSourceBox" Grid.Column="0" Margin="0,0,8,0"
                                     Tag="粘贴源订阅链接、单个源接口地址（JSON / XML 自动识别），或其他设备导出的同步链接"
                                     KeyDown="AddSourceBox_KeyDown" />
                            <Button x:Name="AddSourceButton" Grid.Column="1" Content="添加" Width="74" Height="40"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="AddSourceButton_Click" />
                        </Grid>
                        <CheckBox x:Name="AddSourceAdultCheck" Content="这是成人源(18+)"
                                  Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,10,0,0" />
                        <TextBlock x:Name="AddSourceStatus" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <!-- 多端同步：导出当前全部视频源的同步链接和二维码（数据就在链接里，不经过服务器）。
                             导入不需要单独入口：把其他设备导出的同步链接粘贴到上面的输入框即可 -->
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="SyncExportButton" DockPanel.Dock="Right" Content="同步视频源" Width="112" Height="36"
                                    Margin="12,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="SyncExportButton_Click" />
                            <TextBlock Text="多端同步：导出全部视频源的链接和二维码，在另一台设备上粘贴链接或扫码即可一次性导入。"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Border x:Name="SyncExportPanel" Visibility="Collapsed" Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14"
                                Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="SyncExportSummary" Foreground="{StaticResource TextBrush}" FontSize="13"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="SyncExportContent">
                                    <!-- 二维码按整数倍放大（见 ShowSyncQr），四周空白边已包含在图里 -->
                                    <Border Background="White" HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <Image x:Name="SyncQrCodeImage" Stretch="None" SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <StackPanel x:Name="SyncQrPager" Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,10,0,0" Visibility="Collapsed">
                                        <Button Content="上一张" Width="74" Height="30" FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="SyncQrPrevButton_Click" />
                                        <Button x:Name="SyncQrPauseButton" Content="暂停" Width="88" Height="30" FontSize="12"
                                                Margin="8,0" Style="{StaticResource SecondaryButtonStyle}" Click="SyncQrPauseButton_Click" />
                                        <Button Content="下一张" Width="74" Height="30" FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="SyncQrNextButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="SyncQrPageText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SyncLinkBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True"
                                                 GotKeyboardFocus="SyncLinkBox_GotKeyboardFocus" />
                                        <Button Grid.Column="1" Content="复制链接" Width="96" Height="40"
                                                Style="{StaticResource SecondaryButtonStyle}" Click="SyncCopyButton_Click" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="SyncExportStatus" Foreground="{StaticResource PrimaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SourceSummaryText" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <!-- 片源模式：每个片源一个四档选择（稳定 / 影视 / 全量 / 关闭），改了立即生效并保存 -->
                        <TextBlock Text="片源模式：稳定＝只用该源最稳的一条线路；影视＝只保留影视类内容；全量＝什么都搜；关闭＝不参与搜索与首页。改了立即生效。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceModeStatus" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel x:Name="SourceModesPanel" />
                        </ScrollViewer>
                        <ItemsControl x:Name="ExtraSourcesList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="删除" Height="30" Padding="12,0" Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                                    Click="DeleteExtraSourceButton_Click" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="18+" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Adult}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Api}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Api}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <DockPanel>
                        <ToggleButton x:Name="AutoSkipToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
                        <TextBlock Text="自动跳过广告" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- 代理与分流：直连优先、代理兜底（系统代理 / 强制代理 / 直连）。改了立即保存，下一次搜索 / 播放生效，不随“保存设置”提交 -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="代理与分流（直连优先）" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ComboBox x:Name="PlaybackProxyModeBox" Height="36" FontSize="14" SelectionChanged="PlaybackProxyModeBox_SelectionChanged">
                            <ComboBoxItem Content="系统代理（直连优先，不通才走系统代理）" Tag="system" />
                            <ComboBoxItem Content="强制代理（直连优先，不通才走下面的地址）" Tag="forced" />
                            <ComboBoxItem Content="直连（只直连，不走代理、不兜底）" Tag="direct" />
                        </ComboBox>
                        <TextBox x:Name="PlaybackProxyUrlBox" Margin="0,8,0,0"
                                 Tag="代理地址（HTTP 代理，只在直连不通时使用），例如 http://127.0.0.1:7890"
                                 KeyDown="PlaybackProxyUrlBox_KeyDown" LostFocus="PlaybackProxyUrlBox_LostFocus" />
                        <TextBlock x:Name="PlaybackProxyStatus" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="PlaybackProxySummary" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 弹幕：默认关闭。每一项改了立即生效并保存，不随“保存设置”提交。
                     服务器地址留空时用内置来源（直连腾讯视频、哔哩哔哩、爱奇艺、优酷、芒果TV、咪咕视频的公开弹幕），不需要用户部署任何服务 -->
                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton x:Name="DanmakuToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                          VerticalAlignment="Center" Margin="14,0,0,0"
                                          Checked="DanmakuToggle_Changed" Unchecked="DanmakuToggle_Changed" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="弹幕" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="DanmakuStatus" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel x:Name="DanmakuOptionsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="透明度" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,0,0,7" />
                                    <ComboBox x:Name="DanmakuOpacityBox" Height="36" FontSize="14" SelectionChanged="DanmakuOption_SelectionChanged">
                                        <ComboBoxItem Content="40%" Tag="0.4" />
                                        <ComboBoxItem Content="60%" Tag="0.6" />
                                        <ComboBoxItem Content="80%" Tag="0.8" />
                                        <ComboBoxItem Content="100%" Tag="1" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="滚动速度" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,0,0,7" />
                                    <ComboBox x:Name="DanmakuSpeedBox" Height="36" FontSize="14" SelectionChanged="DanmakuOption_SelectionChanged">
                                        <ComboBoxItem Content="慢" Tag="slow" />
                                        <ComboBoxItem Content="标准" Tag="normal" />
                                        <ComboBoxItem Content="快" Tag="fast" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="字号" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,0,0,7" />
                                    <ComboBox x:Name="DanmakuFontSizeBox" Height="36" FontSize="14" SelectionChanged="DanmakuOption_SelectionChanged">
                                        <ComboBoxItem Content="小" Tag="small" />
                                        <ComboBoxItem Content="标准" Tag="normal" />
                                        <ComboBoxItem Content="大" Tag="large" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="弹幕服务器地址（可选）" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,14,0,7" />
                            <TextBox x:Name="DanmakuServerBox"
                                     Tag="留空即可；高级用户可填自己的 danmu_api 地址，如 http://192.168.1.7:9321"
                                     LostFocus="DanmakuServerBox_LostFocus" KeyDown="DanmakuServerBox_KeyDown" />
                            <TextBlock x:Name="DanmakuServerHint" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="点播下载目录" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="在视频详情页手动下载到本地；正常播放始终走源站，下载完成后可在详情页选择「本地已下载」。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,14" />

                        <TextBlock Text="下载保存目录" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VodCacheDirectoryBox" Grid.Column="0" Margin="0,0,8,0" TextChanged="OnFieldChanged" />
                            <Button Grid.Column="1" Content="选择目录" Height="40" Padding="14,0" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ChooseVodCacheDirectoryButton_Click" />
                            <Button Grid.Column="2" Content="打开目录" Height="40" Padding="14,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OpenVodCacheDirectoryButton_Click" />
                        </Grid>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="立即清理本地下载" Height="34" Padding="14,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ClearVodCacheButton_Click" />
                            <TextBlock x:Name="VodCacheStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton x:Name="UsePotPlayerToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchStyle}"
                                          VerticalAlignment="Center" Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
                            <TextBlock Text="本地文件用 PotPlayer 播放（可选）" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="默认关闭：本地片在本窗口用便携 mpv 内嵌播放。开启后改为外启 PotPlayer。在线视频始终用内置 LibVLC。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,12" />
                        <TextBlock Text="PotPlayer 路径" Foreground="{StaticResource SoftTextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PotPlayerPathBox" Grid.Column="0" Margin="0,0,8,0" TextChanged="OnFieldChanged"
                                     Tag="例如 E:\potPlayer\PotPlayerMini64.exe（可留空自动探测）" />
                            <Button Grid.Column="1" Content="浏览…" Height="40" Padding="14,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BrowsePotPlayerButton_Click" />
                        </Grid>
                        <TextBlock x:Name="PotPlayerStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="主要直播源地址" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBox x:Name="M3uBox" Tag="输入 M3U 直播源地址" TextChanged="OnFieldChanged" />

                        <Border Height="1" Background="{StaticResource BorderBrushDark}" Margin="0,18,0,16" />
                        <TextBlock Text="手动增加直播源" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="新增源会追加在主要源之后；单个新增源失效不会影响主要源。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LiveSourceNameBox" Grid.Column="0" Margin="0,0,8,0" Tag="源名称（如 BBC）" />
                            <TextBox x:Name="LiveSourceUrlBox" Grid.Column="1" Margin="0,0,8,0" Tag="M3U 直播源地址" />
                            <Button Grid.Column="2" Content="添加" Width="74" Height="40"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="AddLiveSourceButton_Click" />
                        </Grid>

                        <ItemsControl x:Name="AdditionalLiveSourcesList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}"
                                            BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,7">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="删除" Height="30" Padding="12,0" Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}" FontSize="12"
                                                    Click="DeleteLiveSourceButton_Click" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LiveSourceEditStatus" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="英语直播同声翻译" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="直播页点「中译」：Deepgram Nova-3 做英语识别+中转 Chat 译中文（验证字幕）；也可选豆包同传/Gemini（字幕+配音）。密钥仅存 Windows 凭据管理器。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14" />

                        <TextBlock Text="翻译引擎" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <ComboBox x:Name="TranslationProviderBox" Height="36" FontSize="14" SelectionChanged="TranslationProviderBox_SelectionChanged">
                            <ComboBoxItem Content="Deepgram Nova-3 STT（仅字幕，推荐验证）" Tag="deepgram" />
                            <ComboBoxItem Content="豆包同声传译 2.0（字幕+配音）" Tag="doubao" />
                            <ComboBoxItem Content="Google Gemini Live Translate（字幕+配音）" Tag="gemini" />
                            <ComboBoxItem Content="OpenAI / 中转站（本机听写 + Chat）" Tag="openai" />
                        </ComboBox>
                        <TextBlock Text="Deepgram：免费 $200 额度，console.deepgram.com 申请 Key；中文翻译仍用下方中转站 Key。豆包需火山语音控制台。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />

                        <TextBlock x:Name="DoubaoAppKeyLabel" Text="豆包 APP ID / APP Key" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <TextBox x:Name="DoubaoAppKeyBox" Tag="火山控制台 · 语音技术 · 应用 APP ID" TextChanged="OnFieldChanged" />
                        <TextBlock x:Name="DoubaoResourceHint"
                                   Text="Resource ID 默认 volc.service_type.10053（同声传译 2.0）。下方 API Key 填 Access Token。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />

                        <TextBlock x:Name="TranslationBaseUrlLabel" Text="Chat 中转站地址（Deepgram / OpenAI 译中文用）" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <TextBox x:Name="TranslationBaseUrlBox" Tag="例如 https://api.example.com；留空=官方 api.openai.com" TextChanged="OnFieldChanged" />
                        <TextBlock x:Name="TranslationBaseUrlHint" Text="Deepgram 模式：此处填中转站，英文识别由 Deepgram 完成，中文由中转 Chat 翻译。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />

                        <TextBlock x:Name="ApiKeyLabel" Text="API Key / Access Token" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <PasswordBox x:Name="OpenAiKeyBox"
                                     Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}" Background="{StaticResource InputBrush}"
                                     BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                     FontSize="14" PasswordChanged="OnFieldChanged" />
                        <DockPanel Margin="0,8,0,8">
                            <Button x:Name="DeleteOpenAiKeyButton" DockPanel.Dock="Right"
                                    Content="删除已存 Key" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="32" Padding="12,0" FontSize="12" Click="DeleteOpenAiKeyButton_Click" />
                            <TextBlock x:Name="OpenAiKeyStatus" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="ChatKeyLabel" Text="Chat 中转 API Key（Deepgram 译中文用，可与上方分开）"
                                   Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" Visibility="Collapsed" />
                        <PasswordBox x:Name="ChatKeyBox"
                                     Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}" Background="{StaticResource InputBrush}"
                                     BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                     FontSize="14" PasswordChanged="OnFieldChanged" Visibility="Collapsed" />
                        <TextBlock x:Name="ChatKeyHint" Visibility="Collapsed"
                                   Text="留空则使用已保存的 OpenAI/中转 Key。Deepgram Key 与中转 Key 分槽保存。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap" />
                        <TextBlock Text="各引擎密钥分开保存。当前引擎对应哪家就填哪家的 Key。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="Chat 翻译模型（Deepgram/OpenAI 用）" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,7" />
                        <TextBox x:Name="TranslationModelBox" Tag="例如 doubao-seed-2-0-pro-260215" TextChanged="OnFieldChanged" />
                        <CheckBox x:Name="TranslationDubbingToggle" Content="播放中文配音（仅豆包 s2s / Gemini；Deepgram 无配音）"
                                  Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,12,0,0"
                                  Checked="OnFieldChanged" Unchecked="OnFieldChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="20,8,20,16">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存设置" Width="120" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="SaveButton_Click" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="13" />
        </DockPanel>
    </Grid>
</UserControl>
